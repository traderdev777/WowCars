# WOwCars Environment Variables
# NEVER commit .env or .env.local to git
# Copy this file to .env.local and fill in the real values

# App
PORT=3000
NODE_ENV=development
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# WhatsApp Concierge (WOwCars Support Number)
NEXT_PUBLIC_WHATSAPP_PHONE="919019088160"

# Database (Prisma — to be configured in Phase 1)
DATABASE_URL="postgresql://user:password@localhost:5432/wowcars"
# For MySQL/MariaDB on cPanel hosting:
# DATABASE_URL="mysql://user:password@localhost:3306/wowcars"

# Authentication (Phase 1)
JWT_SECRET="replace-with-a-64-character-random-hex-string"
BCRYPT_ROUNDS=12

# Cloudflare R2 Image Storage (Phase 2)
R2_ACCOUNT_ID="replace-with-your-cloudflare-account-id"
R2_ACCESS_KEY_ID="replace-with-cloudflare-r2-access-key"
R2_SECRET_ACCESS_KEY="replace-with-cloudflare-r2-secret-key"
R2_BUCKET_NAME="wowcars-media"
R2_PUBLIC_URL="https://media.wowcars.in"

# Transactional Email (Free Brevo / SendGrid)
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT=587
SMTP_USER="replace-with-brevo-smtp-login"
SMTP_PASS="replace-with-brevo-smtp-password"
EMAIL_FROM="noreply@wowcars.in"
